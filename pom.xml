<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.jmeter</groupId>
    <artifactId>jmeter-jtl-xls-report-plugin</artifactId>

    <!--
        VERSION BUMP INSTRUCTIONS
        When cutting a new release, update version and finalName together:
          <version>3.0.0</version>
          <finalName>jmeter-jtl-xls-report-plugin-v3.0.0</finalName>
    -->
    <version>3.0.0</version>

    <packaging>jar</packaging>

    <name>JMeter JTL to Excel Report Plugin</name>
    <description>
        Generates structured Excel SLA reports from JMeter JTL result files.
        Supports JMeter GUI listener mode and headless CLI mode for CI/CD pipelines.
        v3.0.0 adds baseline JTL comparison with 3-sheet Excel output:
        Current Run, Baseline, and Comparison with color-coded regression indicators.
    </description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jmeter.version>5.6.3</jmeter.version>
        <poi.version>5.2.3</poi.version>
    </properties>

    <dependencies>

        <!-- Apache JMeter core (provided — already on classpath at runtime) -->
        <dependency>
            <groupId>org.apache.jmeter</groupId>
            <artifactId>ApacheJMeter_core</artifactId>
            <version>${jmeter.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache POI — Excel generation (bundled into fat JAR)
             commons-compress is excluded because JMeter already provides its own
             version at runtime. Bundling a different version causes an
             IncompatibleClassChangeError during JMeter class scanning on startup. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-compress</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <build>

        <!-- Output: target/jmeter-jtl-xls-report-plugin-v3.0.0.jar -->
        <finalName>jmeter-jtl-xls-report-plugin-v3.0.0</finalName>

        <plugins>

            <!-- 1. Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <!-- 2. Disable thin JAR — fat JAR only -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Fat JAR — all deps bundled, no suffix -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.jmeter.plugin.JMeterAggregateFull</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
